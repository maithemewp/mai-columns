{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mai/column",
  "parent": [
    "mai/columns"
  ],
  "version": "0.2.0",
  "title": "Mai Column",
  "category": "design",
  "description": "An individual row item.",
  "attributes": {
    "alignItems": {
      "type": "string"
    },
    "orderLg": {
      "type": "number"
    },
    "orderMd": {
      "type": "number"
    },
    "orderSm": {
      "type": "number"
    }
  },
  "supports": {
    "anchor": false,
    "align": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "html": false,
    "spacing": {
      "margin": false,
      "padding": true,
      "blockGap": true
    }
  },
  "usesContext": [
    "mai/sizesLg",
    "mai/sizesMd",
    "mai/sizesSm",
    "mai/reverseLg",
    "mai/reverseMd",
    "mai/reverseSm",
    "mai/columnStyles"
  ],
  "textdomain": "mai-columns",
  "editorScript": "file:./index.js"
}